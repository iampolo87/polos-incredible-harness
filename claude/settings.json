{
  "env": {
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "BASH_MAX_OUTPUT_LENGTH": "12000"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Agent(caveman:cavecrew-builder)",
      "Agent(caveman:cavecrew-investigator)",
      "Agent(caveman:cavecrew-reviewer)",
      "Bash(secret-tool:*)",
      "Edit(~/.claude/bin/fastly-mcp-launch)",
      "Edit(~/.claude/hooks/secret-guard.sh)",
      "Read(//**/*.pem)",
      "Read(//**/id_rsa*)",
      "Read(/proc/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.local/share/keyrings/**)",
      "Read(~/.ssh/**)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "skillOverrides": {
    "anthropic-skills:computer-use": "off",
    "anthropic-skills:built-in-browser": "off",
    "anthropic-skills:chrome-browser": "off",
    "anthropic-skills:deep-research": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:skill-creator": "off",
    "anthropic-skills:google-workspace": "off",
    "dataviz": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.local/bin/claude-policy hook",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${HOME}/.claude/hooks/hc-agent-labels.sh\" clear",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.local/bin/claude-policy hook",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.local/bin/claude-policy hook",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep|Glob|Monitor|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${HOME}/.claude/hooks/secret-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash|Agent|Task|Write|Edit|MultiEdit|NotebookEdit|Read|Grep|WebFetch|WebSearch|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.local/bin/claude-policy hook",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.local/bin/claude-policy mine",
            "timeout": 300,
            "async": true
          },
          {
            "type": "command",
            "command": "${HOME}/.local/bin/claude-policy hook",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.local/bin/claude-policy hook",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.local/bin/claude-policy hook",
            "timeout": 5
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.local/bin/claude-policy hook",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "${HOME}/.local/bin/claude-policy statusline ${HOME}/.claude/hooks/caveman-statusline.sh"
  },
  "enabledPlugins": {
    "superpowers@superpowers-marketplace": false,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "caveman@caveman": true,
    "claude-mem@thedotmack": true,
    "cloudflare@cloudflare": false
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-fable-5": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-sonnet-5": {
      "effortLevel": "medium"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-2": {
      "effortLevel": "medium"
    }
  },
  "autoCompactWindow": 300000,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "verbose": false,
  "idleCompaction": false,
  "switchModelsOnFlag": false
}
