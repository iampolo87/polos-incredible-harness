{
    "catalog_version": "1.0",
    "last_reviewed": "2026-06-23",
    "note": "Curated-core set of recommended-but-not-default Adobe Commerce Cloud infra/service settings. Hand-maintained (SWAT does NOT surface these). Refresh procedure in references/config-audit-spec.md.",
    "recommendations": [
        {
            "id": "mysql-optimizer-switch-rowid-filter",
            "setting": "optimizer_switch",
            "recommended_value": "rowid_filter=off",
            "default": "rowid_filter=on (MariaDB 10.4+)",
            "location": "services.yaml",
            "path": ["mysql", "configuration", "optimizer_switch"],
            "match": "contains",
            "applies_to": {"service": "mysql", "min_version": "10.4"},
            "severity": "high",
            "category": "Database",
            "rationale": "Disables the MariaDB rowid_filter optimization that produces bad query plans on Magento's EAV joins (10.4 & 10.6). Adobe documents it as recommended; it is not default.",
            "source_url": "https://experienceleague.adobe.com/en/docs/commerce-on-cloud/user-guide/configure/service/mysql",
            "snippet": "mysql:\n    configuration:\n        optimizer_switch: \"rowid_filter=off\""
        },
        {
            "id": "mysql-optimizer-condition-selectivity",
            "setting": "optimizer_use_condition_selectivity",
            "recommended_value": "1",
            "default": "4 (MariaDB 10.4+)",
            "location": "services.yaml",
            "path": ["mysql", "configuration", "optimizer_use_condition_selectivity"],
            "match": "equals",
            "applies_to": {"service": "mysql", "min_version": "10.4"},
            "severity": "high",
            "category": "Database",
            "rationale": "Forces conservative selectivity statistics; prevents the optimizer from mis-estimating selectivity on complex Magento queries (10.4 & 10.6).",
            "source_url": "https://experienceleague.adobe.com/en/docs/commerce-on-cloud/user-guide/configure/service/mysql",
            "snippet": "mysql:\n    configuration:\n        optimizer_use_condition_selectivity: 1"
        },
        {
            "id": "mysql-max-allowed-packet",
            "setting": "max_allowed_packet",
            "recommended_value": "64M",
            "default": "16M",
            "location": "services.yaml",
            "path": ["mysql", "configuration", "max_allowed_packet"],
            "match": "present",
            "applies_to": {"service": "mysql"},
            "severity": "medium",
            "category": "Database",
            "rationale": "Prevents 'packet too large' errors during bulk imports, large blob saves, and catalog price-rule processing. Default 16M is often too small for big catalogs.",
            "source_url": "https://experienceleague.adobe.com/en/docs/commerce-on-cloud/user-guide/configure/service/mysql",
            "snippet": "mysql:\n    configuration:\n        max_allowed_packet: 64M"
        },
        {
            "id": "deploy-redis-l2-backend",
            "setting": "REDIS_BACKEND",
            "recommended_value": "RemoteSynchronizedCache",
            "default": "Cm_Cache_Backend_Redis",
            "location": ".magento.env.yaml",
            "path": ["stage", "deploy", "REDIS_BACKEND"],
            "match": "contains",
            "applies_to": {"magento_min": "2.3.0"},
            "severity": "high",
            "category": "Cache",
            "rationale": "Enables the L2 cache (local in-process + remote Redis), cutting Redis round-trips dramatically on high-traffic stores.",
            "source_url": "https://experienceleague.adobe.com/en/docs/commerce-on-cloud/user-guide/configure/env/stage/variables-deploy",
            "snippet": "stage:\n    deploy:\n        REDIS_BACKEND: '\\Magento\\Framework\\Cache\\Backend\\RemoteSynchronizedCache'"
        },
        {
            "id": "deploy-mysql-slave",
            "setting": "MYSQL_USE_SLAVE_CONNECTION",
            "recommended_value": "true",
            "default": "false",
            "location": ".magento.env.yaml",
            "path": ["stage", "deploy", "MYSQL_USE_SLAVE_CONNECTION"],
            "match": "equals",
            "applies_to": {"environment": "production-staging"},
            "severity": "medium",
            "category": "Database",
            "rationale": "Routes read queries to the DB replica, offloading the primary under heavy traffic. Recommended for Pro Staging/Production clusters.",
            "source_url": "https://experienceleague.adobe.com/en/docs/commerce-on-cloud/user-guide/configure/env/stage/variables-deploy",
            "snippet": "stage:\n    deploy:\n        MYSQL_USE_SLAVE_CONNECTION: true"
        },
        {
            "id": "deploy-redis-slave",
            "setting": "REDIS_USE_SLAVE_CONNECTION",
            "recommended_value": "true",
            "default": "false",
            "location": ".magento.env.yaml",
            "path": ["stage", "deploy", "REDIS_USE_SLAVE_CONNECTION"],
            "match": "equals",
            "applies_to": {"environment": "production-staging"},
            "severity": "medium",
            "category": "Cache",
            "rationale": "Routes Redis reads to the replica, offloading the Redis primary; falls back to primary on replica failure. Recommended for Pro clusters.",
            "source_url": "https://experienceleague.adobe.com/en/docs/commerce-on-cloud/user-guide/configure/env/stage/variables-deploy",
            "snippet": "stage:\n    deploy:\n        REDIS_USE_SLAVE_CONNECTION: true"
        },
        {
            "id": "global-scd-max-execution-time",
            "setting": "SCD_MAX_EXECUTION_TIME",
            "recommended_value": "3600",
            "default": "900 (implicit)",
            "location": ".magento.env.yaml",
            "path": ["stage", "global", "SCD_MAX_EXECUTION_TIME"],
            "match": "version_gte",
            "applies_to": {"magento_min": "2.2.0"},
            "severity": "low",
            "category": "Deploy",
            "rationale": "Raises the static-content-deploy timeout; the implicit 900s causes silent SCD failures on stores with many theme x locale combinations.",
            "source_url": "https://experienceleague.adobe.com/en/docs/commerce-on-cloud/user-guide/configure/env/stage/variables-global",
            "snippet": "stage:\n    global:\n        SCD_MAX_EXECUTION_TIME: 3600"
        },
        {
            "id": "opcache-max-accelerated-files",
            "setting": "opcache.max_accelerated_files",
            "recommended_value": "60000",
            "default": "10000",
            "location": "php.ini",
            "path": ["opcache.max_accelerated_files"],
            "match": "version_gte",
            "applies_to": {},
            "severity": "high",
            "category": "OPcache",
            "rationale": "Magento 2 has ~50k+ PHP files; the default 10000 causes opcache thrashing and slow page loads. On Cloud set via .magento.app.yaml runtime.",
            "source_url": "https://experienceleague.adobe.com/en/docs/commerce-operations/performance-best-practices/software",
            "snippet": "opcache.max_accelerated_files = 60000"
        },
        {
            "id": "opcache-memory-consumption",
            "setting": "opcache.memory_consumption",
            "recommended_value": "512",
            "default": "128",
            "location": "php.ini",
            "path": ["opcache.memory_consumption"],
            "match": "version_gte",
            "applies_to": {},
            "severity": "medium",
            "category": "OPcache",
            "rationale": "Magento's large codebase exceeds the default 128MB opcode cache; 512MB fits the full opcode set. On Cloud set via .magento.app.yaml runtime.",
            "source_url": "https://experienceleague.adobe.com/en/docs/commerce-operations/performance-best-practices/software",
            "snippet": "opcache.memory_consumption = 512"
        },
        {
            "id": "php-realpath-cache-size",
            "setting": "realpath_cache_size",
            "recommended_value": "10M",
            "default": "4M",
            "location": "php.ini",
            "path": ["realpath_cache_size"],
            "match": "size_gte",
            "applies_to": {},
            "severity": "medium",
            "category": "PHP",
            "rationale": "Caches filesystem stat() calls; Magento's deep include chains benefit. Default 4M is too small.",
            "source_url": "https://experienceleague.adobe.com/en/docs/commerce-operations/performance-best-practices/software",
            "snippet": "realpath_cache_size = 10M"
        },
        {
            "id": "php-realpath-cache-ttl",
            "setting": "realpath_cache_ttl",
            "recommended_value": "7200",
            "default": "120",
            "location": "php.ini",
            "path": ["realpath_cache_ttl"],
            "match": "version_gte",
            "applies_to": {},
            "severity": "low",
            "category": "PHP",
            "rationale": "Keeps resolved paths cached across the request lifetime; default 120s is too short for Magento.",
            "source_url": "https://experienceleague.adobe.com/en/docs/commerce-operations/performance-best-practices/software",
            "snippet": "realpath_cache_ttl = 7200"
        },
        {
            "id": "opcache-validate-timestamps",
            "setting": "opcache.validate_timestamps",
            "recommended_value": "0",
            "default": "1",
            "location": "php.ini",
            "path": ["opcache.validate_timestamps"],
            "match": "equals",
            "applies_to": {"environment": "production"},
            "severity": "medium",
            "category": "OPcache",
            "rationale": "Disables per-request mtime checks for a throughput gain. SAFE ONLY if the deploy process flushes opcache — verify before enabling.",
            "source_url": "https://experienceleague.adobe.com/en/docs/commerce-operations/performance-best-practices/software",
            "snippet": "opcache.validate_timestamps = 0   ; requires opcache flush on deploy"
        }
    ]
}
